+
+// std.posix no longer carries file io for wasi, so these call the syscalls.
+fn fdRead(fd: wasi.fd_t, buf: []u8) !usize {
+    const iov = [1]posix.iovec{.{ .base = buf.ptr, .len = buf.len }};
+    var n: usize = undefined;
+    return switch (wasi.fd_read(fd, &iov, 1, &n)) {
+        .SUCCESS => n,
+        else => |err| posix.unexpectedErrno(err),
+    };
 }
+
+fn fdPread(fd: wasi.fd_t, buf: []u8, offset: u64) !usize {
+    const iov = [1]posix.iovec{.{ .base = buf.ptr, .len = buf.len }};
+    var n: usize = undefined;
+    return switch (wasi.fd_pread(fd, &iov, 1, offset, &n)) {
+        .SUCCESS => n,
+        else => |err| posix.unexpectedErrno(err),
+    };
+}
+
+fn fdWrite(fd: wasi.fd_t, buf: []const u8) !usize {
+    const iov = [1]posix.iovec_const{.{ .base = buf.ptr, .len = buf.len }};
+    var n: usize = undefined;
+    return switch (wasi.fd_write(fd, &iov, 1, &n)) {
+        .SUCCESS => n,
+        else => |err| posix.unexpectedErrno(err),
+    };
+}
+
+fn fdPwrite(fd: wasi.fd_t, buf: []const u8, offset: u64) !usize {
+    const iov = [1]posix.iovec_const{.{ .base = buf.ptr, .len = buf.len }};
+    var n: usize = undefined;
+    return switch (wasi.fd_pwrite(fd, &iov, 1, offset, &n)) {
+        .SUCCESS => n,
+        else => |err| posix.unexpectedErrno(err),
+    };
+}
